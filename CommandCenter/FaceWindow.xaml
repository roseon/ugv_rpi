<Window x:Class="CommandCenter.FaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:CommandCenter.Panels"
        Title="Lance — face" Height="470" Width="560" MinHeight="260" MinWidth="320"
        WindowStartupLocation="Manual" Topmost="True"
        Background="#FF12141A" ShowInTaskbar="True">
    <Grid>
        <p:MouthView x:Name="Mouth" Margin="10"/>

        <!-- The words, while they are being said: the mouth alone reads as a
             mechanism, the words are what make it read as talking. -->
        <TextBlock x:Name="Caption" Text="" Foreground="#FFEDE7E3" FontSize="19"
                   FontStyle="Italic" TextWrapping="Wrap" TextAlignment="Center"
                   VerticalAlignment="Bottom" Margin="34,0,34,16" MaxHeight="76"/>

        <TextBlock x:Name="FaceState" Text="" Style="{StaticResource HudText}"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0"/>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0">
            <TextBlock x:Name="LevelText" Text="level  —" Style="{StaticResource HudText}"
                       HorizontalAlignment="Right"/>
            <Border Background="#FF1B1E23" Height="7" Width="130" CornerRadius="4" Margin="0,3,0,0">
                <Border x:Name="LevelFill" Background="#FF4FF5C0" Width="0"
                        HorizontalAlignment="Left" CornerRadius="4"/>
            </Border>
            <TextBlock Text="drag the mouth to move it by hand" Style="{StaticResource HudText}"
                       HorizontalAlignment="Right" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</Window>
