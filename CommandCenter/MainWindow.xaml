<Window x:Class="CommandCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:CommandCenter.Panels"
        Title="UGV Rover — Command Center" Height="780" Width="1280"
        WindowStartupLocation="CenterScreen" Background="#FF16181C">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#FFB0BEC5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF1B1E23" Padding="14,8">
            <DockPanel>
                <TextBlock Text="🤖 UGV ROVER" FontSize="16" FontWeight="Bold" Foreground="#FF8AB4F8" VerticalAlignment="Center"/>
                <TextBlock Text="  host:" Foreground="#FF78909C" VerticalAlignment="Center" Margin="20,0,4,0"/>
                <TextBox x:Name="HostBox" Width="170" VerticalAlignment="Center" Background="#FF23262B" Foreground="White" BorderBrush="#FF37474F"/>
                <Button x:Name="ConnectBtn" Content="Connect" Style="{StaticResource OpButton}" Click="OnConnect" Width="90"/>
                <TextBlock x:Name="ConnText" Text="○ OFFLINE" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock x:Name="ConnDetail" Text="" Foreground="#FFFFAB91" VerticalAlignment="Center"
                           Margin="10,0,0,0" MaxWidth="620" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="LidarWarn" Text="" Foreground="#FFFFB74D" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <!-- The robot's own wifi, not this PC's link: SSID + signal when it
                     is home, what the watchdog is doing when it is not. Tooltip
                     carries the history (last reconnects, reboots, pinned profile). -->
                <TextBlock x:Name="WifiText" Text="" VerticalAlignment="Center" Margin="16,0,0,0"
                           FontWeight="SemiBold" ToolTipService.InitialShowDelay="200"
                           ToolTip="the robot's wifi — waits for /network_status"/>
                <TextBlock Text="🔊" VerticalAlignment="Center" Margin="18,0,4,0"/>
                <Slider x:Name="VolumeSlider" Width="130" Minimum="0" Maximum="100"
                        VerticalAlignment="Center" ValueChanged="OnVolumeChanged"
                        ToolTip="Robot speaker volume"/>
                <TextBlock x:Name="VolumeText" Text="—" Foreground="#FF78909C" Width="40"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                <TextBlock Text="Command Center v1.0" Foreground="#FF546E7A" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
        <!-- The robot's face rides above the tabs: it is visible whatever page is
             open, and its big window can come up by itself when the robot talks. -->
        <p:FaceBar x:Name="Face" DockPanel.Dock="Top"/>
        <TabControl Background="Transparent" BorderThickness="0">
            <TabItem Header="🕹 Drive"><p:DrivePanel x:Name="DriveTab"/></TabItem>
            <TabItem Header="📡 Radar"><p:RadarPanel x:Name="RadarTab"/></TabItem>
            <TabItem Header="📷 Cameras"><p:CamerasPanel x:Name="CamerasTab"/></TabItem>
            <TabItem Header="🧠 Learning"><p:LearningPanel x:Name="LearningTab"/></TabItem>
            <TabItem Header="💬 Lance"><p:ChatPanel x:Name="ChatTab"/></TabItem>
        </TabControl>
    </DockPanel>
</Window>
