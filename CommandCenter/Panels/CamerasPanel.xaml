<UserControl x:Class="CommandCenter.Panels.CamerasPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelCard}" Grid.Row="0">
            <DockPanel>
                <TextBlock Text="CAMERAS" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                <ListBox x:Name="CamList" Width="380" Height="72" Background="#FF1B1E23" Foreground="White" BorderBrush="#FF37474F"
                         DisplayMemberPath="ToString" Margin="8,0"/>
                <StackPanel VerticalAlignment="Center">
                    <Button Content="Switch stream to selected" Style="{StaticResource OpButton}" Click="OnSwitch"/>
                    <Button Content="🔄 Re-detect / Retry" Style="{StaticResource OpButton}" Click="OnRetry"/>
                    <Button Content="⟳ Refresh list" Style="{StaticResource OpButton}" Click="OnRefresh"/>
                </StackPanel>
                <TextBlock x:Name="CamStatus" Text="" Foreground="#FF4FF5C0" VerticalAlignment="Center" FontWeight="Bold"/>
            </DockPanel>
        </Border>

        <!-- What the robot's own gaze sees.  Every way the eyes can fail to follow
             a person looks identical from outside the robot, so all four links of
             that chain are shown here and the broken one is named. -->
        <Border Style="{StaticResource PanelCard}" Grid.Row="1">
            <DockPanel>
                <TextBlock Text="ROBOT VISION" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                <CheckBox x:Name="ShowBoxes" Content="Boxes" IsChecked="True" Foreground="White"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          Checked="OnShowBoxesChanged" Unchecked="OnShowBoxesChanged"/>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="VisionHealth" Text="" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="VisionCam" Text="CV  —" Style="{StaticResource HudText}"/>
                    <TextBlock x:Name="VisionGaze" Text="GAZE  —" Style="{StaticResource HudText}"/>
                    <TextBlock x:Name="VisionLink" Text="EYES  —" Style="{StaticResource HudText}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <UniformGrid Columns="2" Grid.Row="2">
            <Border Style="{StaticResource PanelCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="VIEW A — main stream, robot detections drawn on it" Style="{StaticResource SectionTitle}"/>
                    <Border Background="Black" CornerRadius="6" ClipToBounds="True">
                        <Grid x:Name="ViewAHost">
                            <Image x:Name="ViewA" Stretch="Uniform"/>
                            <Canvas x:Name="ViewAOverlay" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource PanelCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="VIEW B — second stream (same feed, independent connection)" Style="{StaticResource SectionTitle}"/>
                    <Border Background="Black" CornerRadius="6" ClipToBounds="True">
                        <Image x:Name="ViewB"/>
                    </Border>
                </DockPanel>
            </Border>
        </UniformGrid>
    </Grid>
</UserControl>
